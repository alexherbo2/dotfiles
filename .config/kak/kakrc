set global initial_scratch_message "cd ~/code/chrome-shell
list-friendly-session-names
list-friendly-client-names
cd ~/code/batch
cd ~/code/pw
cd ~/code/chrome-shortcuts
cd ~/code/chrome-dmenu
cd ~/code/chrome-mpv
cd ~/code/mpv-clip
cd ~/code/chrome-pandoc
cd ~/code/chrome-nano
cd ~/code/taupiqueur.github.io
cd ~/notes
cd ~/shorts
view ~/notes.txt
view ~/todo.txt
view ~/games/info.txt
view ~/shorts/ytdlp_list.sh
view ~/books/list.txt
view ~/manga/list.txt
view ~/series/list.txt
view ~/anime/list.txt
view ~/movies/list.txt"
hook global BufCreate '\*scratch\*' %{
  set buffer filetype kakrc
  map -docstring 'evaluate selected text' buffer normal <ret> ':evaluate_selected_text<ret>'
}
face global Tab WhitespaceDiagnosticError
face global Newline Whitespace
face global NonBreakingSpace WhitespaceDiagnosticError
face global Indent Whitespace
hook global BufCreate '.+/i3status/config|.+/sway/config|.+/tmux\.conf|.+/kamux\.conf' %{
  set-option buffer filetype sh
}
