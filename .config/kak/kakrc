set g initial_scratch_message "pwd
list-themes
list-friendly-session-names
list-friendly-client-names
daemonize-session
cd ~/config
cd ~/code/chrome-shell
cd ~/code/batch
cd ~/code/pw
cd ~/code/chrome-shortcuts
cd ~/code/chrome-dmenu
cd ~/code/chrome-mpv
cd ~/code/mpv-clip
cd ~/code/chrome-pandoc
cd ~/code/chrome-nano
cd ~/code/taupiqueur.github.io
cd ~/notes
cd ~/shorts
view ~/Desktop
view ~/Downloads
view ~/Documents
view ~/notes.txt
view ~/todo.txt
view ~/games/info.txt
view ~/shorts/ytdlp_list.sh
view ~/books/list.txt
view ~/manga/list.txt
view ~/series/list.txt
view ~/anime/list.txt
view ~/movies/list.txt
view ~/config
view ~/code/chrome-shell
view ~/code/batch
view ~/code/pw
view ~/code/chrome-shortcuts
view ~/code/chrome-dmenu
view ~/code/chrome-mpv
view ~/code/mpv-clip
view ~/code/chrome-pandoc
view ~/code/chrome-nano
view ~/code/taupiqueur.github.io
view ~/docs
view ~/notes
view ~/shorts
view ~/games
view ~/shorts
view ~/books
view ~/manga
view ~/series
view ~/anime
view ~/movies"
face g Tab WhitespaceDiagnosticError
face g Newline Whitespace
face g NonBreakingSpace WhitespaceDiagnosticError
face g Indent Whitespace
hook g BufSetOption "filetype=ls" %{
  map -docstring "open selected files in mpv" b user m ":enter_command_mode_with_ls_context<ret>open -a mpv --<ret>"
}
hook g BufSetOption "filetype=find" %{
  map -docstring "open selected files in mpv" b user m ":enter_command_mode_with_find_context<ret>open -a mpv --<ret>"
}
hook global BufCreate ".+/i3status/config|.+/sway/config|.+/tmux\.conf|.+/kamux\.conf" %{
  set b filetype sh
}
